Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Timeweb terminates TLS at its proxy, so Apache does not receive scheme state.
  # Canonicalize only the public www hostname; leave technical Timeweb hosts alone.
  RewriteCond %{HTTP_HOST} ^www\.sochipark23\.ru(?::\d+)?$ [NC]
  RewriteRule ^ https://sochipark23.ru%{REQUEST_URI} [R=301,L]

  # `next export` creates same-named folders as well as the .html pages. Redirect
  # these former route aliases before Apache treats the folders as directory URLs.
  RewriteRule ^spasibo/?$ /spasibo.html [R=302,L,NE]
  RewriteRule ^spasibo2/?$ /spasibo2.html [R=302,L,NE]

  # Collapse former landing URLs to the sole canonical page.
  RewriteRule ^(?:index_ctrl113|index_gift2_113|kvartiry-sochi)\.html$ / [R=301,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<FilesMatch "^\\.(?!well-known)">
  Require all denied
</FilesMatch>
